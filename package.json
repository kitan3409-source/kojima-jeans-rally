{
  "name": "kojima-pizza-rally",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @kojima/api dev",
    "dev:web": "pnpm --filter @kojima/web dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @kojima/api db:generate",
    "db:migrate": "pnpm --filter @kojima/api db:migrate",
    "db:seed": "pnpm --filter @kojima/api db:seed"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
